{
  "name": "video-prep-skill",
  "version": "0.1.0",
  "description": "Local-first agent skill for turning a repository into a grounded video preparation brief.",
  "type": "module",
  "bin": {
    "video-prep-skill": "./bin/video-prep-skill.js"
  },
  "scripts": {
    "check": "node --check src/core.js && node --check bin/video-prep-skill.js",
    "test": "node --test",
    "smoke": "node bin/video-prep-skill.js fixtures/sample-repo --format text",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "video",
    "repo-analysis",
    "content"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/video-prep-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/video-prep-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/video-prep-skill#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "docs",
    "examples",
    "src",
    "scripts/package-smoke.js",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ]
}
